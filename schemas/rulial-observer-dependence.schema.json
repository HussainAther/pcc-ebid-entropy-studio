{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy.studio/schemas/rulial-observer-dependence.schema.json",
  "title": "Entropy Studio Rulial Observer Dependence Report",
  "type": "object",
  "required": ["schemaVersion", "experimentId", "ruleSpaceId", "simulation", "observers", "crossObserver", "pairConsensus", "notes"],
  "properties": {
    "schemaVersion": { "const": "entropy-rulial-observer-dependence/1.0.0" },
    "experimentId": { "const": "RUL-004-ECA-OBSERVER-DEPENDENCE-001" },
    "ruleSpaceId": { "const": "RSPACE-ECA-256" },
    "simulation": {
      "type": "object",
      "required": ["policy", "seeds", "splitASeeds", "splitBSeeds", "runCount", "ruleCount", "width", "steps"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "seeds": { "type": "array", "minItems": 8, "items": { "type": "integer" }, "uniqueItems": true },
        "splitASeeds": { "type": "array", "minItems": 4, "items": { "type": "integer" }, "uniqueItems": true },
        "splitBSeeds": { "type": "array", "minItems": 4, "items": { "type": "integer" }, "uniqueItems": true },
        "runCount": { "type": "integer", "minimum": 1 },
        "ruleCount": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 3 },
        "steps": { "type": "integer", "minimum": 1 }
      }
    },
    "observers": { "type": "array", "minItems": 2 },
    "crossObserver": { "type": "array", "minItems": 1 },
    "pairConsensus": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
