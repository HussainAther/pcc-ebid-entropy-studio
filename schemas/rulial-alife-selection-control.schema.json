{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entropy-rulial-alife-selection-control/1.0.0",
  "title": "RUL-021 ALife selection versus neutral bottleneck report",
  "type": "object",
  "required": ["schemaVersion", "experimentId", "ruleSpaceId", "observerId", "design", "simulation", "conditions", "pairedComparison", "primaryTest", "interpretationBoundary"],
  "properties": {
    "schemaVersion": {"const": "entropy-rulial-alife-selection-control/1.0.0"},
    "experimentId": {"const": "RUL-021"},
    "ruleSpaceId": {"const": "RSPACE-ALIFE-001"},
    "observerId": {"const": "OBSERVER-ALIFE-SELECTION-CONTROL"},
    "design": {"type": "object", "required": ["seedCount", "seeds", "conditions", "ruleDimensions", "burnInSteps", "postShockSteps", "neutralControl", "primaryCriteria"]},
    "simulation": {"type": "object", "required": ["runCount", "steps", "shockStep", "initialPopulation", "populationCap"]},
    "conditions": {"type": "object", "required": ["stable_mutable", "scarcity_mutable", "neutral_bottleneck_mutable"]},
    "pairedComparison": {"type": "object", "required": ["medianSelectiveMinusNeutralPostShockDisplacement", "positiveSeedCount", "seedCount", "medianNeutralBottleneckMatchError"]},
    "primaryTest": {"type": "object", "required": ["selectiveExceedsNeutralPostShockMotion", "selectiveExcessPositiveInMajority", "selectiveDirectionExceedsNeutral", "neutralBottleneckMatched", "selectivePopulationPersists", "criteriaPassed", "criteriaTotal", "pilotSupported"]},
    "interpretationBoundary": {"type": "array", "items": {"type": "string"}}
  }
}
