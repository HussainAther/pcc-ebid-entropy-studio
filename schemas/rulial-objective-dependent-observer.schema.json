{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entropy-rulial-objective-dependent-observer/1.0.0",
  "title": "RUL-018 objective-dependent observer report",
  "type": "object",
  "required": ["schemaVersion", "experimentId", "source", "design", "objectiveOptima", "objectiveRankAssociations", "objectiveDependence", "observerSubsets"],
  "properties": {
    "schemaVersion": {"const": "entropy-rulial-objective-dependent-observer/1.0.0"},
    "experimentId": {"const": "RUL-018"},
    "source": {"type": "object", "required": ["experimentId", "newUniqueSimulationRunCount", "reconstructedFrozenRunCount"]},
    "design": {"type": "object", "required": ["featureCount", "nonEmptyObserverSubsetCount", "objectives"]},
    "objectiveOptima": {"type": "array", "minItems": 3, "maxItems": 3},
    "objectiveRankAssociations": {"type": "array", "minItems": 3, "maxItems": 3},
    "objectiveDependence": {"type": "object", "required": ["allObjectivesShareAtLeastOneOptimum", "globalAndLocalOptimaDiffer", "paretoFrontSize", "objectiveDependenceDetected"]},
    "observerSubsets": {"type": "array", "minItems": 63, "maxItems": 63}
  },
  "additionalProperties": true
}
