{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy.studio/schemas/rulial-alife-lineage-transport.schema.json",
  "title": "RUL-026 ALife lineage transport report",
  "type": "object",
  "required": ["schemaVersion", "experimentId", "ruleSpaceId", "observerId", "source", "design", "results", "primaryTest", "interpretationBoundary", "runs"],
  "properties": {
    "schemaVersion": {"const": "entropy-rulial-alife-lineage-transport/1.0.0"},
    "experimentId": {"const": "RUL-026"},
    "ruleSpaceId": {"const": "RSPACE-ALIFE-001"},
    "observerId": {"const": "OBSERVER-ALIFE-LINEAGE-TRANSPORT"},
    "source": {"type": "object"},
    "design": {"type": "object"},
    "results": {"type": "object"},
    "primaryTest": {
      "type": "object",
      "required": ["criteria", "criteriaPassed", "criteriaTotal", "pilotSupported"],
      "properties": {
        "criteria": {"type": "object"},
        "criteriaPassed": {"type": "integer"},
        "criteriaTotal": {"const": 6},
        "pilotSupported": {"type": "boolean"}
      }
    },
    "interpretationBoundary": {"type": "string"},
    "runs": {"type": "array", "minItems": 24, "maxItems": 24}
  }
}
