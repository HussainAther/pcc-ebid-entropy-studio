{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy.studio/schemas/rulial-validation.schema.json",
  "title": "Entropy Studio Rulial Validation Report",
  "type": "object",
  "required": ["schemaVersion", "validationId", "ruleSpaceId", "observerId", "holdout", "bootstrap", "stability", "neighborhoodSensitivity", "equivalence", "externalClassification"],
  "properties": {
    "schemaVersion": { "const": "entropy-rulial-validation/1.0.0" },
    "validationId": { "type": "string", "minLength": 1 },
    "ruleSpaceId": { "type": "string", "minLength": 1 },
    "observerId": { "type": "string", "minLength": 1 },
    "holdout": {
      "type": "object",
      "required": ["seeds", "runCount", "profileCount", "policy"],
      "properties": {
        "seeds": { "type": "array", "minItems": 1, "items": { "type": "integer" }, "uniqueItems": true },
        "runCount": { "type": "integer", "minimum": 1 },
        "profileCount": { "type": "integer", "minimum": 1 },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "bootstrap": { "type": "object" },
    "stability": { "type": "object" },
    "neighborhoodSensitivity": { "type": "object" },
    "equivalence": { "type": "object" },
    "externalClassification": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
